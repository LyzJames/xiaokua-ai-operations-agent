# Key.txt is read at runtime. Do not put credentials into frontend code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# json (stable) or strict_tools (DeepSeek Beta, still locally schema-validated).
DEEPSEEK_ANALYSIS_FORMAT=json
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Use websocket when event AND card subscriptions use the official long connection.
FEISHU_DELIVERY=https-webhook
# Production Compose feishu-ws profile: copy the organization connection ID.
FEISHU_CONNECTION_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: use an existing installed-app Admin API token.
SHOPIFY_ACCESS_TOKEN=

# Amazon: each merchant supplies their own LWA authorization. Sandbox is the default.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_REGION=na
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
# Local import always uses sandbox; production connection must be explicit in the Web UI.

# Local product runtime. Production requires HTTPS + PostgreSQL + independent keys.
APP_ENV=development
PUBLIC_URL=http://127.0.0.1:8000
WORKER_ENABLED=true
ALLOW_REGISTRATION=false
SHOPIFY_TEST_ONLY=true
# Optional local storage path; default is data/product.sqlite.
# DATABASE_URL=sqlite:///data/product.sqlite
# Production: use scripts/prepare_deploy.py and Compose secret files.
# DATABASE_URL_FILE=/run/secrets/database_url
# ENCRYPTION_KEYS_FILE=/run/secrets/encryption_key
