# Replace public identifiers and hostname in your OWN Shopify application.
# This is a standalone merchant workbench, not an embedded Admin app.
client_id = "YOUR_SHOPIFY_CLIENT_ID"
name = "小跨 AI运营官"
application_url = "https://ops.example.com"
embedded = false

[access_scopes]
scopes = "read_orders,write_orders,read_products,write_products,read_inventory,write_inventory,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders"
use_legacy_install_flow = true

[auth]
redirect_urls = ["https://ops.example.com/api/shopify/callback"]

[webhooks]
api_version = "2026-10"

[[webhooks.subscriptions]]
topics = ["orders/create", "orders/updated", "orders/cancelled", "refunds/create", "fulfillments/create", "fulfillments/update", "inventory_levels/update", "products/update", "products/delete", "app/uninstalled"]
uri = "/hooks/shopify"

[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "/hooks/shopify"
